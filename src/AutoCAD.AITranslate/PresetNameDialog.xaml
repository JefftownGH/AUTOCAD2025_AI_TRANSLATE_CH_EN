<Window x:Class="AutoCAD.AITranslate.PresetNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="方案名称"
        Width="380" Height="170"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="名称：" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" VerticalContentAlignment="Center"
                 MaxLength="60"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="HintText"
                   Margin="0,10,0,0" FontSize="11" Foreground="#777777" TextWrapping="Wrap"
                   Text="名称用于在选择列表中区分不同方案，例如「公司网关」「本地 Ollama」。"/>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" Width="80" Height="26" Margin="0,0,8,0"
                    Click="OkButton_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Height="26" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
