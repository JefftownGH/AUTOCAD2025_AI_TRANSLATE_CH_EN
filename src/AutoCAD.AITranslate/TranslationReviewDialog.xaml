<Window x:Class="AutoCAD.AITranslate.TranslationReviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="翻译预览 — AutoCAD AI 翻译"
    Width="1000" Height="680"
    MinWidth="820" MinHeight="520"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>

        <!-- Small grey chip used for the provenance label (machine / cache / edited) -->
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="Auto"/>  <!-- language + mode pickers -->
            <RowDefinition Height="*"/>     <!-- the bilingual list -->
            <RowDefinition Height="Auto"/>  <!-- summary + bulk actions -->
            <RowDefinition Height="Auto"/>  <!-- buttons -->
        </Grid.RowDefinitions>

        <!-- ================= header ================= -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="HeaderText" Text="翻译预览" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock x:Name="HeaderSubText" Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                       Text="确认或修改译文后写入图纸。未勾选的行不会被修改。"/>
        </StackPanel>

        <!-- ================= language + write mode ================= -->
        <Border Grid.Row="1" Background="#F7F7F7" BorderBrush="#E2E2E2" BorderThickness="1"
                CornerRadius="3" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="目标语言" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="LanguageBox" Grid.Column="1" Width="180"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="LanguageBox_SelectionChanged"/>

                <TextBlock Grid.Column="3" Text="写入方式" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <RadioButton x:Name="ModeBilingual" Content="双语对照（原文保留，译文放到新图层）"
                                 IsChecked="True" VerticalAlignment="Center"
                                 Checked="WriteMode_Changed"/>
                    <RadioButton x:Name="ModeReplace" Content="直接替换原文" Margin="18,0,0,0"
                                 VerticalAlignment="Center"
                                 Checked="WriteMode_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= two-column bilingual list ================= -->
        <Border Grid.Row="2" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- column headings -->
                <Grid Grid.Row="0" Background="#EFEFEF">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>   <!-- confirm -->
                        <ColumnDefinition Width="*"/>    <!-- original -->
                        <ColumnDefinition Width="*"/>    <!-- translated -->
                        <ColumnDefinition Width="92"/>   <!-- provenance -->
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="写入" FontSize="11" FontWeight="SemiBold"
                               Foreground="#666666" HorizontalAlignment="Center" Margin="0,6"/>
                    <TextBlock Grid.Column="1" Text="原文" FontSize="11" FontWeight="SemiBold"
                               Foreground="#666666" Margin="8,6"/>
                    <TextBlock Grid.Column="2" Text="译文（可直接编辑）" FontSize="11" FontWeight="SemiBold"
                               Foreground="#666666" Margin="8,6"/>
                    <TextBlock Grid.Column="3" Text="来源" FontSize="11" FontWeight="SemiBold"
                               Foreground="#666666" Margin="8,6"/>
                </Grid>

                <ListBox x:Name="RowList" Grid.Row="1" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="92"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsConfirmed, Mode=TwoWay}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ToolTip="取消勾选则此行不写入图纸"/>

                                <TextBlock Grid.Column="1" Text="{Binding OriginalText}"
                                           Margin="8,5" TextWrapping="Wrap" VerticalAlignment="Center"/>

                                <!-- Editable translation cell. Multi-line because drawing
                                     labels legitimately contain \P line breaks. -->
                                <TextBox Grid.Column="2" Text="{Binding TranslatedText, Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged}"
                                         Margin="8,3" Padding="3,2" MinHeight="26"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalContentAlignment="Center"
                                         ToolTip="可直接修改译文；修改后的内容会被记住并在下次翻译时优先使用"/>

                                <TextBlock Grid.Column="3" Text="{Binding SourceLabel}"
                                           Style="{StaticResource ChipText}"
                                           Margin="8,5" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ================= summary + bulk actions ================= -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="SummaryText" FontWeight="SemiBold"/>
                <TextBlock x:Name="SummarySubText" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SelectAllButton" Content="全部写入" Style="{StaticResource ToolbarButton}"
                        Click="SelectAll_Click"/>
                <Button x:Name="SelectNoneButton" Content="全部跳过" Style="{StaticResource ToolbarButton}"
                        Click="SelectNone_Click"/>
                <Button x:Name="RetranslateButton" Content="重译未确认项" Style="{StaticResource ToolbarButton}"
                        Click="Retranslate_Click"/>
            </StackPanel>
        </Grid>

        <!-- ================= buttons ================= -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ApplyButton" Content="写入图纸" IsDefault="True" MinWidth="96"
                    Padding="10,4" Margin="0,0,8,0" Click="Apply_Click"/>
            <Button x:Name="CancelButton" Content="取消" IsCancel="True" MinWidth="80" Padding="10,4"/>
        </StackPanel>
    </Grid>
</Window>
